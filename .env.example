# Modèle des secrets d'exploitation. Copier en .env.local et remplir.
#
# À la RACINE et non dans app/ : app/.env.local est lu par Vite, et tout
# ce qui y porte le préfixe VITE_ finit dans le bundle public. Une clé
# secrète n'a rien à faire dans le même fichier que la config du
# navigateur — il suffirait d'un renommage pour la publier.
#
# Lu uniquement par tools/db_prod.sh. Jamais versionné (.gitignore).

SUPABASE_PROJECT_REF=
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publique par conception : part dans le bundle, c'est normal.
SUPABASE_PUBLISHABLE_KEY=

# CONTOURNE TOUTES LES RLS. Jamais dans le front, jamais dans un
# workflow public, jamais dans un collage.
SUPABASE_SECRET_KEY=

SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_PASSWORD=
